---
import BaseLayout from '../layouts/BaseLayout.astro';
import HoursWidget from '../components/HoursWidget.astro';
---

<BaseLayout title="Contact" description="Find Renaissance Coffee in the AQ Building at SFU Burnaby Campus. Hours, phone number, and directions.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="text-center mb-12">
      <h1 class="font-heading text-4xl sm:text-5xl font-bold text-coffee mb-3">Find Us</h1>
      <p class="text-espresso-light">We're in the Academic Quadrangle building at SFU Burnaby. Look for the coffee aroma.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Map -->
      <div>
        <div class="rounded-xl overflow-hidden border border-caramel/20 aspect-square md:aspect-auto md:h-full">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2603.5!2d-122.9185!3d49.2781!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5486764842c4a2a5%3A0x8e7fef9c7e24a5bb!2sSimon%20Fraser%20University!5e0!3m2!1sen!2sca!4v1"
            width="100%"
            height="100%"
            style="border:0; min-height: 300px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Renaissance Coffee location map"
          ></iframe>
        </div>
      </div>

      <!-- Info -->
      <div class="space-y-8">
        <!-- Address -->
        <div>
          <h2 class="font-heading text-xl font-semibold text-coffee mb-2">Location</h2>
          <div class="flex items-start gap-3 text-espresso-light">
            <svg class="w-5 h-5 text-coffee shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <div>
              <p class="font-medium text-espresso">Academic Quadrangle (AQ) Building</p>
              <p>Simon Fraser University</p>
              <p>8888 University Dr E, Burnaby, BC</p>
            </div>
          </div>
        </div>

        <!-- Phone -->
        <div>
          <h2 class="font-heading text-xl font-semibold text-coffee mb-2">Phone</h2>
          <a href="tel:+17787824455" class="flex items-center gap-3 text-espresso-light hover:text-coffee transition-colors">
            <svg class="w-5 h-5 text-coffee shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <span class="font-medium">(778) 782-4455</span>
          </a>
        </div>

        <!-- Hours -->
        <div>
          <h2 class="font-heading text-xl font-semibold text-coffee mb-3">Hours</h2>
          <HoursWidget />
        </div>

        <!-- Instagram -->
        <div>
          <h2 class="font-heading text-xl font-semibold text-coffee mb-2">Instagram</h2>
          <a
            href="https://www.instagram.com/renaissance.coffee/"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-espresso-light hover:text-coffee transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            <span>@renaissance.coffee</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
