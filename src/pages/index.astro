---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuCategory from '../components/MenuCategory.astro';
import yaml from 'js-yaml';
import { readFileSync } from 'fs';

const menuFile = readFileSync('src/data/menu.yml', 'utf-8');
const menuData = yaml.load(menuFile) as {
  categories: { name: string; id: string; items: { name: string; price: string; description?: string }[] }[]
};

// Featured items for homepage
const featured = [
  { name: "Latte", price: "5.00", description: "Our most popular drink — espresso with steamed milk" },
  { name: "Vegetable Samosa", price: "3.00", description: "A campus favourite for 30 years" },
  { name: "Butter Chicken", price: "10.50", description: "Parminder's recipe, served with rice" },
  { name: "Raspberry Scone", price: "4.00", description: "Baked fresh in-house every morning" },
];
---

<BaseLayout title="Home" description="Renaissance Coffee — a family-owned coffee shop at SFU Burnaby since 1996. Coffee, bagels, samosas, butter chicken, and baked goods in the AQ Building.">
  <!-- Hero -->
  <section class="relative bg-coffee text-cream overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1600&q=80')] bg-cover bg-center opacity-30"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-28 md:py-36 text-center">
      <p class="text-caramel font-medium tracking-wide uppercase text-sm mb-3 fade-in">Est. 1996 — Family Owned</p>
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold mb-4 fade-in">
        Renaissance Coffee
      </h1>
      <p class="text-lg sm:text-xl text-cream/80 max-w-2xl mx-auto mb-8 fade-in">
        30 years of coffee, community, and home-cooked food at SFU Burnaby.
        Come for the coffee, stay for the warmth.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center fade-in">
        <a href="/order" class="bg-caramel text-espresso font-semibold px-8 py-3 rounded-full hover:bg-caramel-light transition-colors">
          Order for Pickup
        </a>
        <a href="/story" class="border border-cream/40 text-cream font-medium px-8 py-3 rounded-full hover:bg-cream/10 transition-colors">
          Our Story
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Info Bar -->
  <section class="bg-cream-dark border-y border-caramel/15">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-5">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8 text-sm text-espresso">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-coffee" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span>Mon–Thu 6am–7:30pm · Fri 6am–5:30pm</span>
        </div>
        <div class="hidden sm:block w-px h-4 bg-caramel/30"></div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-coffee" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          <span>AQ Building, SFU Burnaby Campus</span>
        </div>
        <div class="hidden sm:block w-px h-4 bg-caramel/30"></div>
        <a href="tel:+17787824455" class="flex items-center gap-2 hover:text-coffee transition-colors">
          <svg class="w-4 h-4 text-coffee" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          (778) 782-4455
        </a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16 text-center">
    <h2 class="font-heading text-3xl sm:text-4xl font-semibold text-coffee mb-4">
      More Than Just Coffee
    </h2>
    <p class="text-espresso-light leading-relaxed">
      For 30 years, Renaissance Coffee has been the heart of the SFU Burnaby campus.
      Started by Parminder Parhar and his wife Kamaljit in 1996, what began as a small
      coffee stand has become a beloved institution — a place where students fuel late-night
      study sessions, professors grab their morning americano, and the samosas are always fresh.
      Everything we can, we bake in-house. Everything we serve, we make with care.
    </p>
  </section>

  <!-- Featured Items -->
  <section class="bg-cream-dark py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-heading text-3xl font-semibold text-coffee mb-8 text-center">
        Campus Favourites
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {featured.map(item => (
          <div class="bg-cream rounded-xl p-5 border border-caramel/15 hover:border-caramel/30 transition-colors">
            <div class="flex justify-between items-start mb-2">
              <h3 class="font-heading text-lg font-semibold text-coffee">{item.name}</h3>
              <span class="font-heading font-bold text-forest">${item.price}</span>
            </div>
            <p class="text-sm text-espresso-light/70">{item.description}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/menu" class="inline-flex items-center gap-1 text-coffee font-medium hover:gap-2 transition-all">
          See full menu
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Community Highlight -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
    <div class="bg-forest rounded-2xl p-8 sm:p-10 text-cream text-center">
      <h2 class="font-heading text-2xl sm:text-3xl font-semibold mb-3">
        30 Years of Community
      </h2>
      <p class="text-cream/80 max-w-2xl mx-auto mb-6">
        Renaissance Coffee isn't just a coffee shop — it's part of SFU's fabric. From our student
        scholarship endowment to our annual events, we believe in giving back to the community
        that has supported us for three decades.
      </p>
      <a href="/community" class="inline-block bg-cream text-forest font-semibold px-6 py-2.5 rounded-full hover:bg-cream-dark transition-colors">
        Learn More
      </a>
    </div>
  </section>
</BaseLayout>
