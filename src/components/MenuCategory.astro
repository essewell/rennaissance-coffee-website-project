---
import MenuItem from './MenuItem.astro';

interface Props {
  name: string;
  id: string;
  items: { name: string; price: string; description?: string }[];
}

const { name, items } = Astro.props;
---

<section class="mb-8">
  <h3 class="font-heading text-2xl font-semibold text-coffee mb-4 pb-2 border-b border-caramel/30">
    {name}
  </h3>
  <div class="divide-y divide-caramel/10">
    {items.map(item => (
      <MenuItem name={item.name} price={item.price} description={item.description} />
    ))}
  </div>
</section>
