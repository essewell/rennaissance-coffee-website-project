---
import HoursWidget from './HoursWidget.astro';
---

<footer class="bg-espresso text-cream/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <h3 class="font-heading text-xl font-bold text-cream mb-3">Renaissance Coffee</h3>
        <p class="text-sm leading-relaxed text-cream/60">
          A family-owned coffee shop serving the SFU Burnaby community since 1996.
          Fresh coffee, homemade food, and warm hospitality.
        </p>
      </div>

      <!-- Hours -->
      <div>
        <h3 class="font-heading text-lg font-semibold text-cream mb-3">Hours</h3>
        <HoursWidget compact={true} />
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-heading text-lg font-semibold text-cream mb-3">Find Us</h3>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <span>AQ Building, SFU Burnaby Campus<br />Burnaby, BC</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <a href="tel:+17787824455" class="hover:text-cream transition-colors">(778) 782-4455</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
            <a href="https://www.instagram.com/renaissance.coffee/" target="_blank" rel="noopener" class="hover:text-cream transition-colors">@renaissance.coffee</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-cream/10 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-cream/40">
      <p>&copy; {new Date().getFullYear()} Renaissance Coffee. All rights reserved.</p>
      <p>Serving SFU Burnaby since 1996</p>
    </div>
  </div>
</footer>
